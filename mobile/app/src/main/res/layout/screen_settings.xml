<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Settings" android:textColor="@color/ink" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="DAILY REMINDER" android:textColor="@color/muted" android:textSize="14sp" />
        <Switch android:id="@+id/reminder_switch" android:layout_width="match_parent" android:layout_height="56dp" android:text="Remind me every day" android:textColor="@color/ink" android:textSize="16sp" />
        <TextView android:id="@+id/reminder_time" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:textColor="@color/ink" android:textSize="16sp" />
        <TextView android:id="@+id/reminder_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Around your chosen local time" android:textColor="@color/muted" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="ACCOUNT" android:textColor="@color/muted" android:textSize="14sp" />
        <TextView android:id="@+id/account_email" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:textColor="@color/ink" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:text="Currency: INR (₹)" android:textColor="@color/ink" android:textSize="16sp" />
        <TextView android:id="@+id/account_sync" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:textColor="@color/ink" android:textSize="16sp" />
        <TextView android:id="@+id/sign_out" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:gravity="center_vertical" android:text="Sign out" android:textColor="@color/primary" android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
