<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="8dp" android:paddingBottom="24dp">
        <TextView style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:text="Settings" android:textSize="24sp" android:accessibilityHeading="true" />
        <TextView style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Budget" />
        <LinearLayout android:id="@+id/settings_budget_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/card_3d" android:paddingLeft="16dp" android:paddingRight="12dp" android:paddingTop="14dp" android:paddingBottom="19dp" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/settings_budget_title" style="@style/Text.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" />
                <TextView android:id="@+id/settings_budget_sub" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textStyle="normal" />
            </LinearLayout>
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_next" android:tint="@color/muted" android:importantForAccessibility="no" />
        </LinearLayout>
        <TextView style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Appearance" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:background="@drawable/segment_bg" android:padding="3dp">
            <TextView android:id="@+id/theme_system" style="@style/Text.Heading" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="System" android:clickable="true" android:focusable="true" android:contentDescription="Follow the phone's light or dark setting" />
            <TextView android:id="@+id/theme_light" style="@style/Text.Heading" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="Light" android:clickable="true" android:focusable="true" android:contentDescription="Always light" />
            <TextView android:id="@+id/theme_dark" style="@style/Text.Heading" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:text="Dark" android:clickable="true" android:focusable="true" android:contentDescription="Always dark" />
        </LinearLayout>
        <TextView style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Budget alerts" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" android:background="@drawable/card_3d" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="6dp" android:paddingBottom="11dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="16sp" android:textStyle="bold" android:text="Warn me about my budget" />
                <Switch android:id="@+id/alerts_switch" android:layout_width="wrap_content" android:layout_height="48dp" android:contentDescription="Warn me about my budget" />
            </LinearLayout>
            <TextView android:id="@+id/alerts_help" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="normal" android:text="A notification when you have used most of the budget, gone over it, or are spending faster than it allows. It never shows amounts." android:paddingBottom="4dp" />
        </LinearLayout>
        <TextView style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Daily reminder" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" android:background="@drawable/card_3d" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="6dp" android:paddingBottom="11dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="16sp" android:textStyle="bold" android:text="Remind me every day" />
                <Switch android:id="@+id/reminder_switch" android:layout_width="wrap_content" android:layout_height="48dp" android:contentDescription="Remind me every day" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="2dp" android:background="@drawable/divider" />
            <TextView android:id="@+id/reminder_time" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:textSize="16sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/reminder_help" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="normal" android:text="It runs around this time every day. Notifications never show amounts." android:paddingBottom="4dp" />
        </LinearLayout>
        <TextView style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Account" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" android:background="@drawable/card_3d" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="6dp" android:paddingBottom="11dp">
            <TextView android:id="@+id/account_email" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:textSize="15sp" android:textStyle="bold" />
            <View android:layout_width="match_parent" android:layout_height="2dp" android:background="@drawable/divider" />
            <TextView style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:textSize="15sp" android:text="Currency: INR (₹)" />
            <View android:layout_width="match_parent" android:layout_height="2dp" android:background="@drawable/divider" />
            <TextView android:id="@+id/account_sync" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:textSize="15sp" android:clickable="true" android:focusable="true" />
        </LinearLayout>
        <TextView android:id="@+id/sign_out" style="@style/Text.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/btn_danger" android:textColor="@color/bad" android:text="Sign out" android:clickable="true" android:focusable="true" />
    </LinearLayout>
</ScrollView>
