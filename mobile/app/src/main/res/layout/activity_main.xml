<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <FrameLayout android:id="@+id/screen" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:id="@+id/nav" android:layout_width="match_parent" android:layout_height="70dp" android:orientation="horizontal"
        android:background="@drawable/nav_bg" android:paddingTop="6dp" android:paddingBottom="6dp" android:paddingLeft="8dp" android:paddingRight="8dp">
        <LinearLayout android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginRight="3dp"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/nav_item_bg" android:clickable="true" android:focusable="true" android:contentDescription="Home">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_home" android:tint="@color/nav_tint" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Home" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/nav_tint" android:fontFamily="@font/nunito" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_history" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginRight="3dp"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/nav_item_bg" android:clickable="true" android:focusable="true" android:contentDescription="History">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_history" android:tint="@color/nav_tint" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="History" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/nav_tint" android:fontFamily="@font/nunito" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_insights" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginRight="3dp"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/nav_item_bg" android:clickable="true" android:focusable="true" android:contentDescription="Insights">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_insights" android:tint="@color/nav_tint" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Insights" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/nav_tint" android:fontFamily="@font/nunito" />
        </LinearLayout>
        <LinearLayout android:id="@+id/nav_settings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginRight="3dp"
            android:orientation="vertical" android:gravity="center" android:background="@drawable/nav_item_bg" android:clickable="true" android:focusable="true" android:contentDescription="Settings">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_settings" android:tint="@color/nav_tint" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Settings" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/nav_tint" android:fontFamily="@font/nunito" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
