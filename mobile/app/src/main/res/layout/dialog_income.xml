<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Add income" />
    <TextView style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Name" />
    <EditText android:id="@+id/income_name_input" style="@style/Text.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:hint="For example Diwali bonus" android:inputType="textCapWords" android:maxLength="40" android:contentDescription="Name" />
    <TextView style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Amount (₹)" />
    <EditText android:id="@+id/income_amount_input" style="@style/Text.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:hint="Amount in ₹" android:inputType="numberDecimal" android:maxLength="14" android:contentDescription="Amount in rupees" />
    <TextView style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Received on" />
    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:columnCount="3">
        <TextView android:id="@+id/income_date_today" style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:gravity="center" android:paddingBottom="4dp" android:textStyle="bold" android:background="@drawable/chip_3d" android:text="Today" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/income_date_yesterday" style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:gravity="center" android:paddingBottom="4dp" android:textStyle="bold" android:background="@drawable/chip_3d" android:text="Yesterday" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/income_date_pick" style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:gravity="center" android:paddingBottom="4dp" android:textStyle="bold" android:background="@drawable/chip_3d" android:text="Pick date" android:clickable="true" android:focusable="true" />
    </GridLayout>
    <TextView android:id="@+id/income_error" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/bad" android:textStyle="bold" />
</LinearLayout>
</ScrollView>
