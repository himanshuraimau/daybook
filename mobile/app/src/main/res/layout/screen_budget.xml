<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="12dp" android:paddingRight="12dp">
        <ImageView android:id="@+id/budget_back" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:paddingBottom="14dp" android:background="@drawable/icon_btn" android:src="@drawable/ic_back" android:tint="@color/ink" android:contentDescription="Back" android:clickable="true" android:focusable="true" />
        <TextView style="@style/Text.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="12dp" android:text="Budget" android:accessibilityHeading="true" />
        <TextView android:id="@+id/budget_skip" style="@style/Text.Heading" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:paddingLeft="10dp" android:paddingRight="10dp" android:textColor="@color/muted" android:text="Set up later" android:visibility="gone" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:background="@drawable/card_3d" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="14dp" android:paddingBottom="19dp">
                <TextView style="@style/Text.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Monthly salary" android:textSize="17sp" />
                <TextView style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textStyle="normal" android:text="What reaches your account each month." />
                <EditText android:id="@+id/budget_income" style="@style/Text.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="₹ 50,000" android:inputType="numberDecimal" android:maxLength="14" android:contentDescription="Monthly salary in rupees" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:background="@drawable/card_3d" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="14dp" android:paddingBottom="19dp">
                <TextView style="@style/Text.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Payday" android:textSize="17sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:id="@+id/payday_minus" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:paddingBottom="15dp" android:background="@drawable/icon_btn" android:src="@drawable/ic_back" android:tint="@color/ink" android:contentDescription="Earlier payday" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/payday_value" style="@style/Text.Display" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="30sp" android:accessibilityLiveRegion="polite" />
                    <ImageView android:id="@+id/payday_plus" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:paddingBottom="15dp" android:background="@drawable/icon_btn" android:src="@drawable/ic_next" android:tint="@color/ink" android:contentDescription="Later payday" android:clickable="true" android:focusable="true" />
                </LinearLayout>
                <TextView android:id="@+id/payday_help" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textStyle="normal" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:background="@drawable/card_3d" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="14dp" android:paddingBottom="19dp">
                <TextView style="@style/Text.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fixed spends" android:textSize="17sp" />
                <TextView style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textStyle="normal" android:text="Things you must pay every month, like rent. They are set aside first." />
                <LinearLayout android:id="@+id/fixed_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" />
                <TextView android:id="@+id/fixed_add" style="@style/Text.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/btn_amber" android:textColor="@color/on_amber" android:text="+  Add fixed spend" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/fixed_totals" style="@style/Text.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textSize="15sp" android:accessibilityLiveRegion="polite" />
            </LinearLayout>
            <TextView android:id="@+id/budget_error" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/bad" android:textStyle="bold" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
    </ScrollView>
    <TextView android:id="@+id/budget_save" style="@style/Text.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="16dp" android:layout_marginRight="16dp" android:layout_marginTop="6dp" android:layout_marginBottom="12dp" android:background="@drawable/btn_primary" android:textColor="@color/on_accent" android:text="Save budget" android:clickable="true" android:focusable="true" />
</LinearLayout>
