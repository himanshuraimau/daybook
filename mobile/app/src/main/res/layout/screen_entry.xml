<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="12dp" android:paddingRight="12dp">
        <ImageView android:id="@+id/entry_back" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:paddingBottom="14dp" android:background="@drawable/icon_btn" android:src="@drawable/ic_back" android:tint="@color/ink" android:contentDescription="Back" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/entry_title" style="@style/Text.Title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="12dp" android:accessibilityHeading="true" />
        <TextView android:id="@+id/entry_delete" style="@style/Text.Heading" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:paddingLeft="10dp" android:paddingRight="10dp" android:textColor="@color/bad" android:text="Delete" android:visibility="gone" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingBottom="8dp">
            <TextView style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Amount" />
            <TextView android:id="@+id/entry_amount" style="@style/Text.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="46sp" android:textFontWeight="800" android:contentDescription="Amount" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/entry_error" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/bad" android:textStyle="bold" android:accessibilityLiveRegion="polite" />
            <TextView style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Category" />
            <GridLayout android:id="@+id/entry_categories" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:columnCount="3" />
            <TextView android:id="@+id/entry_emi_link" style="@style/Text.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:textSize="14sp" android:textColor="@color/accent_dark" android:text="Paying in instalments? Set up an EMI" android:clickable="true" android:focusable="true" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="13dp" android:paddingRight="13dp" android:paddingTop="6dp" android:paddingBottom="10dp">
        <GridLayout android:id="@+id/entry_dates" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:columnCount="3">
                <TextView android:id="@+id/entry_date_today" style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:gravity="center" android:paddingBottom="4dp" android:textStyle="bold" android:background="@drawable/chip_3d" android:text="Today" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/entry_date_yesterday" style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:gravity="center" android:paddingBottom="4dp" android:textStyle="bold" android:background="@drawable/chip_3d" android:text="Yesterday" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/entry_date_pick" style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:gravity="center" android:paddingBottom="4dp" android:textStyle="bold" android:background="@drawable/chip_3d" android:text="Pick date" android:clickable="true" android:focusable="true" />
            </GridLayout>
        <EditText android:id="@+id/entry_note" style="@style/Text.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginBottom="6dp" android:layout_marginLeft="3dp" android:layout_marginRight="3dp" android:hint="Add a note (optional)" android:inputType="textCapSentences" android:maxLength="240" android:imeOptions="actionDone" android:contentDescription="Note" />
        <include layout="@layout/view_numpad" />
        <TextView android:id="@+id/entry_save" style="@style/Text.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="3dp" android:layout_marginRight="3dp" android:layout_marginTop="8dp" android:background="@drawable/btn_primary" android:textColor="@color/on_accent" android:text="Save expense" android:clickable="true" android:focusable="true" />
    </LinearLayout>
</LinearLayout>
