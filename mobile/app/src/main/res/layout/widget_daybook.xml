<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/widget_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/on_accent" android:alpha="0.85" android:maxLines="1" />
        <TextView android:id="@+id/widget_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/on_accent" android:maxLines="1" />
        <TextView android:id="@+id/widget_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="12sp" android:textColor="@color/on_accent" android:maxLines="1" />
    </LinearLayout>
    <FrameLayout android:id="@+id/widget_add" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginLeft="8dp" android:background="@drawable/bg_circle" android:contentDescription="Add expense">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_plus_teal" android:importantForAccessibility="no" />
    </FrameLayout>
</LinearLayout>
