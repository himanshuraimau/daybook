<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
    <TextView android:id="@+id/sd_label" style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" />
    <FrameLayout android:id="@+id/sd_dot" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginTop="4dp">
        <ImageView android:id="@+id/sd_check" android:layout_width="14dp" android:layout_height="14dp" android:layout_gravity="center" android:src="@drawable/ic_check" android:tint="@color/on_accent" android:importantForAccessibility="no" />
    </FrameLayout>
</LinearLayout>
