<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="8dp">
    <TextView style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:text="History" android:textSize="24sp" android:accessibilityHeading="true" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/prev_cycle" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:paddingBottom="14dp" android:background="@drawable/icon_btn" android:src="@drawable/ic_back" android:tint="@color/ink" android:contentDescription="Previous period" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/history_cycle" style="@style/Text.Heading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textSize="17sp" />
        <ImageView android:id="@+id/next_cycle" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:paddingBottom="14dp" android:background="@drawable/icon_btn" android:src="@drawable/ic_next" android:tint="@color/ink" android:contentDescription="Next period" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <TextView android:id="@+id/history_total" style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textSize="13sp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="16dp">
        <LinearLayout android:id="@+id/history_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
