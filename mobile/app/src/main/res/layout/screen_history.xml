<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="History" android:textColor="@color/ink" android:textSize="28sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/prev_month" android:layout_width="48dp" android:layout_height="match_parent" android:gravity="center" android:text="‹" android:textColor="@color/primary" android:textSize="28sp" android:contentDescription="Previous month" />
        <TextView android:id="@+id/history_month" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="@color/ink" android:textSize="18sp" />
        <TextView android:id="@+id/next_month" android:layout_width="48dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textColor="@color/primary" android:textSize="28sp" android:contentDescription="Next month" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/history_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
