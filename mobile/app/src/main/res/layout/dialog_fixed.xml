<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/fixed_title" style="@style/Text.Title" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/fixed_name_label" style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Name" />
        <EditText android:id="@+id/fixed_name_input" style="@style/Text.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:hint="Name, for example Rent" android:inputType="textCapWords" android:maxLength="40" android:contentDescription="Name" />
    <TextView android:id="@+id/fixed_amount_label" style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Amount per month (₹)" />
        <EditText android:id="@+id/fixed_amount_input" style="@style/Text.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:hint="Amount per month in ₹" android:inputType="numberDecimal" android:maxLength="14" android:contentDescription="Amount per month in rupees" />
    <LinearLayout android:id="@+id/emi_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
    <TextView android:id="@+id/fixed_months_label" style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Number of months" />
            <EditText android:id="@+id/fixed_months_input" style="@style/Text.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:hint="Number of months, for example 12" android:inputType="number" android:maxLength="3" android:contentDescription="Number of months" />
    <TextView android:id="@+id/fixed_total_label" style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Total cost (₹, optional)" />
            <EditText android:id="@+id/fixed_total_input" style="@style/Text.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:hint="Total cost in ₹ (optional)" android:inputType="numberDecimal" android:maxLength="14" android:contentDescription="Total cost in rupees" />
        <TextView android:id="@+id/fixed_summary" style="@style/Text.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="14sp" android:accessibilityLiveRegion="polite" />
        <TextView style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="First instalment" />
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:columnCount="2">
            <TextView android:id="@+id/fixed_start_this" style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:gravity="center" android:paddingBottom="4dp" android:textStyle="bold" android:background="@drawable/chip_3d" android:text="This cycle" android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/fixed_start_next" style="@style/Text.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:gravity="center" android:paddingBottom="4dp" android:textStyle="bold" android:background="@drawable/chip_3d" android:text="Next cycle" android:clickable="true" android:focusable="true" />
        </GridLayout>
    <TextView android:id="@+id/fixed_paid_label" style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Instalments already paid" />
            <EditText android:id="@+id/fixed_paid_input" style="@style/Text.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:hint="Instalments already paid (0)" android:inputType="number" android:maxLength="3" android:contentDescription="Instalments already paid" />
        <TextView style="@style/Text.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textStyle="normal" android:text="Set aside automatically every cycle until it ends. You don't need to add it as an expense." />
    </LinearLayout>
    <TextView android:id="@+id/fixed_category_label" style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Category" />
        <GridLayout android:id="@+id/fixed_categories" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:columnCount="2" />
    <TextView android:id="@+id/fixed_error" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/bad" android:textStyle="bold" />
</LinearLayout>
</ScrollView>
