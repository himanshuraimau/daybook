<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_vertical">
        <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:layout_marginTop="32dp" android:background="@drawable/logo_circle">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:layout_marginBottom="3dp" android:src="@drawable/ic_wallet" android:tint="@color/on_accent" android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView style="@style/Text.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Daybook" />
        <TextView style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/muted" android:textSize="16sp" android:text="Know what you spent, one day at a time." />
        <TextView style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="Email" />
        <EditText android:id="@+id/auth_email" style="@style/Text.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="name@example.com" android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:importantForAutofill="yes" android:contentDescription="Email" />
        <TextView style="@style/Text.Overline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Password" />
        <EditText android:id="@+id/auth_password" style="@style/Text.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="At least 8 characters" android:inputType="textPassword" android:autofillHints="password" android:importantForAutofill="yes" android:contentDescription="Password" />
        <TextView android:id="@+id/auth_error" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/bad" android:textStyle="bold" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/auth_submit" style="@style/Text.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/btn_primary" android:textColor="@color/on_accent" android:text="Log in" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/auth_toggle" style="@style/Text.Heading" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/accent_dark" android:text="Create account" android:clickable="true" android:focusable="true" />
    </LinearLayout>
</ScrollView>
